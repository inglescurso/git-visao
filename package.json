{
  "name": "git-visao",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Cloudflare Workers + D1 + OmniRoute para catalogar, resumir (5 variacoes) e buscar repositorios GitHub",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --keep-vars",
    "db:migrate:local": "wrangler d1 migrations apply git_visao_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply git_visao_db --remote",
    "test": "node --experimental-strip-types --test tests/worker.test.ts",
    "import:all": "node --experimental-strip-types scripts/import_repos.ts",
    "import:dry-run": "node --experimental-strip-types scripts/import_repos.ts --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.14.0"
  }
}
